<Window x:Class="OppoUnlockToolbox.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OppoUnlockToolbox.Controls"
        Title="关于" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FontSans}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Style="{StaticResource DialogCard}" Margin="18" MouseLeftButtonDown="OnDragArea">
        <StackPanel Margin="22,20,22,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}"
                        Background="{DynamicResource BrandPrimary}">
                    <ui:IconBox Key="shield" Size="18" Foreground="#FFFFFF"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="OPPO 解锁工具箱" FontSize="{StaticResource FontTitleSm}"
                               FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="VersionText" Text="" FontSize="{StaticResource FontTiny}"
                               Foreground="{DynamicResource TextTertiary}"/>
                </StackPanel>
            </StackPanel>

            <Separator Style="{StaticResource AppSeparator}" Margin="0,16"/>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" ClipToBounds="True"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/author.jpg"
                               Stretch="UniformToFill" Width="50" Height="50"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AuthorNameText" Text="" FontSize="{StaticResource FontSub}"
                                       FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <Border Style="{StaticResource ChipBrand}" Margin="8,0,0,0">
                                <TextBlock x:Name="CoolapkChipText" Text=""
                                           FontSize="{StaticResource FontTiny}"
                                           Foreground="{DynamicResource BrandPrimary}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="工具箱开发 &amp; 机型适配" FontSize="{StaticResource FontSmall}"
                                   Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="BlessingText" Text="" FontSize="{StaticResource FontSmall}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="GithubBtn" Style="{StaticResource BtnSecondary}" Height="32"
                        Click="OnGithubClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="link" Size="14" Margin="0,0,7,0"/>
                        <TextBlock Text="GitHub 主页" FontSize="{StaticResource FontSmall}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CoolapkBtn" Style="{StaticResource BtnSecondary}" Height="32"
                        Margin="10,0,0,0" Click="OnCoolapkClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="link" Size="14" Margin="0,0,7,0"/>
                        <TextBlock Text="酷安主页" FontSize="{StaticResource FontSmall}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button x:Name="CloseBtn" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right"
                    MinWidth="96" Margin="0,18,0,0" Click="OnCloseClick">
                <StackPanel Orientation="Horizontal">
                    <ui:IconBox Key="check" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="关闭"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
