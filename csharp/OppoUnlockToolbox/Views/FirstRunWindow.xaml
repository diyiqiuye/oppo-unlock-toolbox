<Window x:Class="OppoUnlockToolbox.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OppoUnlockToolbox.Controls"
        Title="开始之前" Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FontSans}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Style="{StaticResource DialogCard}" Margin="18" MouseLeftButtonDown="OnDragArea">
        <StackPanel Margin="22,20,22,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}"
                        Background="{DynamicResource BrandSoft}">
                    <ui:IconBox Key="alert" Size="18" Foreground="{DynamicResource BrandPrimary}"/>
                </Border>
                <TextBlock Text="开始之前 · 使用须知" FontSize="{StaticResource FontTitleSm}"
                           FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>

            <Border Background="{DynamicResource DangerSoft}" CornerRadius="{StaticResource RadiusCard}"
                    Padding="14,12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="警告" FontSize="{StaticResource FontCaption}" FontWeight="Bold"
                               Foreground="{DynamicResource Danger}"/>
                    <TextBlock Margin="0,7,0,0" FontSize="{StaticResource FontCaption}"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                               Text="解锁会让手机清空全部数据，先把照片、微信、文件自己导出备份。临时 root 会直接改写内核内存，参数不对或运气不好会重启手机 —— 仅限你自己的设备，风险自负。"/>
                </StackPanel>
            </Border>

            <TextBlock Text="怎么用" FontSize="{StaticResource FontSub}" FontWeight="Bold"
                       Margin="0,18,0,0" Foreground="{DynamicResource TextPrimary}"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Width="20" Height="20"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource BrandSoft}" VerticalAlignment="Top">
                    <TextBlock Text="1" FontSize="{StaticResource FontTiny}" FontWeight="Bold"
                               Foreground="{DynamicResource BrandPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="{StaticResource FontCaption}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                           Margin="12,0,0,0"
                           Text="临时 Root 只支持 ColorOS 14 系统的机器；先用顶栏的「资源下载」把 bundle 和 KernelSU 管理器准备好。"/>

                <Border Grid.Row="1" Grid.Column="0" Width="20" Height="20" Margin="0,12,0,0"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource BrandSoft}" VerticalAlignment="Top">
                    <TextBlock Text="2" FontSize="{StaticResource FontTiny}" FontWeight="Bold"
                               Foreground="{DynamicResource BrandPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{StaticResource FontCaption}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                           Margin="12,12,0,0"
                           Text="按左边 1 → 7 的顺序往下做就行：一步跑完再跑下一步，中间不要跳步。"/>
            </Grid>

            <Button x:Name="ConfirmBtn" Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Right" MinWidth="130" Margin="0,22,0,0"
                    IsEnabled="False" Click="OnConfirmClick" Content="确定（5s）"/>
        </StackPanel>
    </Border>
</Window>
