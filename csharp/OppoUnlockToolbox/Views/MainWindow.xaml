<Window x:Class="OppoUnlockToolbox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OppoUnlockToolbox.Controls"
        xmlns:fields="clr-namespace:OppoUnlockToolbox.ViewModels.Fields"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="1320" Height="880" MinWidth="1080" MinHeight="660"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource Background}"
        FontFamily="{StaticResource FontSans}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 主操作按钮：危险阶段（写入 / 解锁 / 还原）自动换成红底。 -->
        <Style x:Key="BtnRun" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Stage.RunIsDanger}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Stage.RunIsDanger}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerHover}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Stage.RunIsDanger}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsPressed}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 右栏「设备环境」里的一行。 -->
        <DataTemplate x:Key="DeviceRowTemplate">
            <Border Padding="14,10" BorderBrush="{DynamicResource GlassPanelBorder}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="{Binding IconKey}" Size="14" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextTertiary}"/>
                        <TextBlock Text="{Binding Caption}" FontSize="{StaticResource FontSmall}"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="RowValue" Text="{Binding Value}" FontSize="{StaticResource FontSub}"
                               FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Note}" FontSize="{StaticResource FontSmall}"
                               Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter TargetName="RowValue" Property="Foreground" Value="{DynamicResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="danger">
                    <Setter TargetName="RowValue" Property="Foreground" Value="{DynamicResource Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 会话卡里的一行只读信息。 -->
        <Style x:Key="MetaRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- 参数表单的行样式：除第一行外，行底部画一条分隔线。 -->
        <Style x:Key="FieldRow" TargetType="Border">
            <Setter Property="Padding" Value="0,9,0,11"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPanelBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <DataTrigger Value="0">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                    </DataTrigger.Binding>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>

        <!-- ── 参数表单：每种字段一个模板，按 VM 类型自动选用 ── -->

        <DataTemplate DataType="{x:Type fields:NoteFieldViewModel}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldHint}" Margin="0,4,0,8"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:BooleanFieldViewModel}">
            <Border Style="{StaticResource FieldRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource AppSwitch}"
                                  HorizontalAlignment="Left" IsChecked="{Binding Value, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:ChoiceFieldViewModel}">
            <Border Style="{StaticResource FieldRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource AppRadio}" Content="{Binding Text}"
                                             GroupName="{Binding DataContext.GroupName,
                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                             Margin="0,0,18,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:MultiFieldViewModel}">
            <Border Style="{StaticResource FieldRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource AppCheck}" Content="{Binding Text}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="0,0,18,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:PathFieldViewModel}">
            <Border Style="{StaticResource FieldRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                    <Button Grid.Column="1" Style="{StaticResource BtnGlass}"
                            HorizontalAlignment="Left" Command="{Binding PickCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconBox Key="folder" Size="15" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" MaxWidth="430"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:TextFieldViewModel}">
            <Border Style="{StaticResource FieldRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Style="{StaticResource AppInput}"
                             Width="{Binding Width}" HorizontalAlignment="Left"
                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding AboutCommand}"/>
        <KeyBinding Key="F2" Command="{Binding ResourcesCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RunCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoToStageCommand}" CommandParameter="temproot"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoToStageCommand}" CommandParameter="push"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding GoToStageCommand}" CommandParameter="backup"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding GoToStageCommand}" CommandParameter="write"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding GoToStageCommand}" CommandParameter="fastboot"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding GoToStageCommand}" CommandParameter="verify"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding GoToStageCommand}" CommandParameter="restore"/>
    </Window.InputBindings>

    <Border x:Name="RootBorder" Background="{DynamicResource Background}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 背景照片：轻微模糊 + 压一层，玻璃面板上的文字才读得清 -->
            <Grid Grid.RowSpan="2" ClipToBounds="True">
                <Image Source="pack://application:,,,/Assets/background.jpg"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect Radius="6" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
            </Grid>
            <Rectangle Grid.RowSpan="2" Fill="{DynamicResource Scrim}"/>

            <!-- ══════════ 顶栏 ══════════ -->
            <Border Grid.Row="0" Background="{DynamicResource GlassPanel}"
                    BorderBrush="{DynamicResource GlassPanelBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Rectangle Width="27" Height="23" VerticalAlignment="Center"
                                   ToolTip="OPPO 解锁工具箱"
                                   Fill="{DynamicResource TextPrimary}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/mark.png"
                                            Stretch="Uniform"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="OPPO 解锁工具箱" FontSize="{StaticResource FontSub}"
                                   FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="4,0,16,0">
                        <Button Style="{StaticResource SearchPill}" Width="400"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="设备状态，点击重新检测"
                                ToolTip="点击重新检测设备（F5）"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:IconBox Key="phone" Size="14" VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontCaption}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Device.ModeText}"/>
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontCaption}"
                                           Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Left" MaxWidth="220"
                                           Text="{Binding Device.StatusDetail}" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="3" Style="{StaticResource KbdBadge}" Margin="12,0,0,0">
                                    <TextBlock Text="F5" FontSize="{StaticResource FontTiny}"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                Command="{Binding ThemeCommand}" ToolTip="{Binding ThemeToggleTip}"
                                AutomationProperties.Name="切换主题"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:IconBox Key="{Binding ThemeIconKey}" Size="16"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                                ToolTip="重新检测（F5）" AutomationProperties.Name="重新检测"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:IconBox Key="refresh" Size="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                Command="{Binding OpenBackupDirCommand}"
                                ToolTip="打开备份目录" AutomationProperties.Name="打开备份目录"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:IconBox Key="folder" Size="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                Command="{Binding ResourcesCommand}"
                                ToolTip="资源下载（F2）" AutomationProperties.Name="资源下载"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:IconBox Key="download" Size="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                Command="{Binding AboutCommand}"
                                ToolTip="关于（F1）" AutomationProperties.Name="关于"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:IconBox Key="info" Size="16"/>
                        </Button>

                        <Border Width="1" Height="20" Margin="8,0"
                                Background="{DynamicResource GlassPanelBorder}"/>

                        <Button Style="{StaticResource WindowControlButton}" Click="OnMinimizeClick"
                                AutomationProperties.Name="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:IconBox Key="window_min" Size="12"/>
                        </Button>
                        <Button Style="{StaticResource WindowControlButton}" Click="OnMaximizeClick"
                                AutomationProperties.Name="最大化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:IconBox x:Name="MaximizeGlyph" Key="window_max" Size="12"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="OnCloseClick"
                                AutomationProperties.Name="关闭"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:IconBox Key="close" Size="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════ 主体：左导航 / 中间内容 / 右栏 ══════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>

                <!-- 左：解锁流程 -->
                <Border Grid.Column="0" Background="{DynamicResource GlassPanel}"
                        BorderBrush="{DynamicResource GlassPanelBorder}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,14,10,14">
                        <!-- 标题行：左边小标题，右边当前进度 -->
                        <Grid DockPanel.Dock="Top" Margin="10,0,10,0">
                            <TextBlock Text="解锁流程" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding Stage.StageProgress}" HorizontalAlignment="Right"
                                       FontSize="{StaticResource FontSmall}"
                                       Foreground="{DynamicResource TextTertiary}"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Margin="10,11,10,14"
                                Background="{DynamicResource GlassPanelBorder}"/>

                        <!-- 底部：整轮进度，顺便把下面的空档收住 -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource GlassCard}"
                                Padding="12,11" Margin="6,16,6,0">
                            <StackPanel>
                                <TextBlock Text="本次进度" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding ProgressSummary}" Margin="0,7,0,0"
                                           FontSize="{StaticResource FontSub}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <ProgressBar Style="{StaticResource AppProgress}" Height="6"
                                             Margin="0,9,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="StageRail" ItemsSource="{Binding Rail}"
                                 SelectedItem="{Binding SelectedRail, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:IconBox x:Name="NavIcon" Key="{Binding IconKey}" Size="16"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextTertiary}"/>
                                        <TextBlock x:Name="NavLabel" Grid.Column="1" Text="{Binding Title}"
                                                   FontSize="{StaticResource FontSub}" Margin="11,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="NavGlyph" Grid.Column="2" Text="{Binding Glyph}"
                                                   FontSize="{StaticResource FontSmall}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding VisualState}" Value="active">
                                            <Setter TargetName="NavIcon" Property="Foreground"
                                                    Value="{DynamicResource BrandPrimary}"/>
                                            <Setter TargetName="NavGlyph" Property="Foreground"
                                                    Value="{DynamicResource BrandPrimary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VisualState}" Value="done">
                                            <Setter TargetName="NavIcon" Property="Foreground"
                                                    Value="{DynamicResource Success}"/>
                                            <Setter TargetName="NavGlyph" Property="Foreground"
                                                    Value="{DynamicResource Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VisualState}" Value="fail">
                                            <Setter TargetName="NavIcon" Property="Foreground"
                                                    Value="{DynamicResource Danger}"/>
                                            <Setter TargetName="NavGlyph" Property="Foreground"
                                                    Value="{DynamicResource Danger}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 中：阶段卡 + 参数卡 + 实时输出 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220" MinHeight="120"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="RightScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  Padding="20,16,20,10">
                        <StackPanel>
                            <!-- 阶段卡 -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel Margin="20,18,20,18">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ChipBrand}">
                                            <TextBlock Text="{Binding Stage.StageChipText}"
                                                       FontSize="{StaticResource FontSmall}"
                                                       Foreground="{DynamicResource BrandPrimary}"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipOutline}" Margin="8,0,0,0"
                                                Visibility="{Binding Stage.NeedsRootVisible,
                                                    Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Stage.NeedsRootText}"
                                                       FontSize="{StaticResource FontSmall}"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipDanger}" Margin="8,0,0,0"
                                                Visibility="{Binding Stage.DangerVisible,
                                                    Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:IconBox Key="alert" Size="12" Margin="0,0,4,0"
                                                            Foreground="{DynamicResource Danger}"/>
                                                <TextBlock Text="危险" FontSize="{StaticResource FontSmall}"
                                                           Foreground="{DynamicResource Danger}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Stage.Title}"
                                               Style="{StaticResource TextTitleLg}" Margin="0,10,0,0"
                                               TextWrapping="Wrap"/>

                                    <Border Background="{DynamicResource DangerSoft}"
                                            CornerRadius="{StaticResource RadiusControl}" Padding="14,10"
                                            Margin="0,14,0,0"
                                            Visibility="{Binding Stage.DangerVisible,
                                                Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:IconBox Key="alert" Size="15" Margin="0,1,9,0"
                                                        Foreground="{DynamicResource Danger}"/>
                                            <TextBlock Text="{Binding Stage.DangerText}"
                                                       FontSize="{StaticResource FontCaption}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Danger}"
                                                       MaxWidth="780" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Style="{StaticResource BtnRun}" Command="{Binding RunCommand}"
                                                AutomationProperties.Name="执行本阶段">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:IconBox Key="play" Size="15" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding Stage.RunLabel}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BtnGlass}" Margin="8,0,0,0"
                                                Command="{Binding StopCommand}"
                                                AutomationProperties.Name="停止">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:IconBox Key="stop" Size="15" Margin="0,0,7,0"/>
                                                <TextBlock Text="停止"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BtnGlass}" Margin="8,0,0,0"
                                                Command="{Binding CopyCommand}"
                                                AutomationProperties.Name="复制命令">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:IconBox Key="copy" Size="15" Margin="0,0,7,0"/>
                                                <TextBlock Text="复制命令"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Style="{StaticResource AppProgress}"
                                                     VerticalAlignment="Center"
                                                     Value="{Binding Stage.ProgressValue}"
                                                     IsIndeterminate="{Binding Stage.ProgressIndeterminate}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Stage.ProgressText}"
                                                   FontSize="{StaticResource FontSmall}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                                   MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 参数卡 -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Text="参数" FontSize="{StaticResource FontSub}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </Border>
                                    <Border Style="{StaticResource CardBody}" Padding="20,6,20,10">
                                        <StackPanel>
                                            <TextBlock Text="这一阶段没有参数，直接执行即可。"
                                                       FontSize="{StaticResource FontCaption}"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       Margin="0,6,0,6"
                                                       Visibility="{Binding Stage.HasNoFields,
                                                           Converter={StaticResource BoolToVis}}"/>
                                            <ItemsControl ItemsSource="{Binding Stage.Fields}"
                                                          AlternationCount="2"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows" Cursor="SizeNS"/>

                    <!-- 实时输出 -->
                    <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="20,0,20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CardHeader}" Padding="16,10,12,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:IconBox Key="terminal" Size="15"
                                                    Foreground="{DynamicResource TextTertiary}"/>
                                        <TextBlock Text="实时输出" FontSize="{StaticResource FontSub}"
                                                   FontWeight="Bold" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource AppCheck}" Content="自动滚动"
                                                  FontSize="{StaticResource FontSmall}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Logs.AutoScroll, Mode=TwoWay}"/>
                                        <Button Style="{StaticResource BtnGhost}" Height="28" Margin="12,0,0,0"
                                                Command="{Binding ClearLogCommand}">
                                            <TextBlock Text="清空" FontSize="{StaticResource FontSmall}"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnGhost}" Height="28" Margin="4,0,0,0"
                                                Command="{Binding SaveLogCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:IconBox Key="save" Size="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="保存日志" FontSize="{StaticResource FontSmall}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Logs.Entries}"
                                     BorderThickness="0" Background="Transparent" Padding="0,2,0,2"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     Focusable="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="16,1,16,1">
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontTiny}"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       VerticalAlignment="Top" Margin="0,1,12,0"/>
                                            <TextBlock Text="{Binding MessageText}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontSmall}"
                                                       TextWrapping="Wrap" Foreground="{Binding Brush}"
                                                       MaxWidth="1100" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="IsTabStop" Value="False"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 右：设备环境 + 会话 -->
                <Border Grid.Column="2" Background="{DynamicResource GlassPanel}"
                        BorderBrush="{DynamicResource GlassPanelBorder}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,12,14">
                        <StackPanel>
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}" Padding="14,11,14,9">
                                        <TextBlock Text="设备环境" FontSize="{StaticResource FontSub}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Device.Tiles}"
                                                  ItemTemplate="{StaticResource DeviceRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}" Padding="14,11,14,9">
                                        <TextBlock Text="会话" FontSize="{StaticResource FontSub}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </Border>
                                    <Border Style="{StaticResource CardBody}" Padding="14,10,14,14">
                                        <StackPanel>
                                            <StackPanel Style="{StaticResource MetaRow}" Margin="0">
                                                <TextBlock Text="版本" Style="{StaticResource MetaLabel}"/>
                                                <TextBlock Text="{Binding Version}"
                                                           Style="{StaticResource MetaValue}"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource MetaRow}">
                                                <TextBlock Text="工作目录" Style="{StaticResource MetaLabel}"/>
                                                <TextBlock Text="{Binding WorkDir}"
                                                           Style="{StaticResource MetaValue}"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource MetaRow}">
                                                <TextBlock Text="日志目录" Style="{StaticResource MetaLabel}"/>
                                                <TextBlock Text="{Binding LogDir}"
                                                           Style="{StaticResource MetaValue}"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource MetaRow}">
                                                <TextBlock Text="当前阶段" Style="{StaticResource MetaLabel}"/>
                                                <TextBlock Text="{Binding Stage.Title}"
                                                           Style="{StaticResource MetaValue}"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
