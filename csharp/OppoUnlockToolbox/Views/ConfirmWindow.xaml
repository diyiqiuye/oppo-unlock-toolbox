<Window x:Class="OppoUnlockToolbox.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OppoUnlockToolbox.Controls"
        Title="确认执行" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FontSans}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Style="{StaticResource DialogCard}" Margin="18" MouseLeftButtonDown="OnDragArea">
        <StackPanel Margin="22,20,22,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}"
                        Background="{DynamicResource DangerSoft}">
                    <ui:IconBox Key="alert" Size="18" Foreground="{DynamicResource Danger}"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="" FontSize="{StaticResource FontTitleSm}"
                           FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Text="" FontSize="{StaticResource FontCaption}"
                       Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource BtnSecondary}" MinWidth="92" Content="取消"
                        Click="OnCancelClick"/>
                <Button x:Name="ConfirmBtn" Style="{StaticResource BtnDanger}" MinWidth="92"
                        Margin="10,0,0,0" Click="OnConfirmClick">
                    <TextBlock x:Name="ConfirmText" Text="执行"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
