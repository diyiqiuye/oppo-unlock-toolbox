<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OppoUnlockToolbox</RootNamespace>
    <AssemblyName>OppoUnlockToolbox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>OPPO 解锁工具箱</Product>
    <Company></Company>
    <Version>0.3</Version>
    <FileVersion>0.3</FileVersion>
    <AssemblyTitle>OPPO 解锁工具箱</AssemblyTitle>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\author.jpg" />
    <Resource Include="Assets\background.jpg" />
    <Resource Include="Assets\mark.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OppoUnlockToolbox.Core\OppoUnlockToolbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- net48 没有单文件发布，用 Costura 把 Core.dll 和 System.Text.Json 那串依赖嵌进 exe，
         发布产物因此仍是单个 exe（配置见 FodyWeavers.xml）。 -->
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
