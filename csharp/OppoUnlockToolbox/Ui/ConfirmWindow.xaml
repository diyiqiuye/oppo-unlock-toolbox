<Window x:Class="OppoUnlockToolbox.Ui.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OppoUnlockToolbox.Ui"
        Title="确认执行" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Base}"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource R.Card}"
            BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="16">
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal">
                <ui:IconBox Key="alert" Size="20" Foreground="{StaticResource Danger}"
                            VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="" FontSize="16" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Text="" FontSize="13" Margin="0,12,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource Ink2}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource BtnDefault}" MinWidth="92" Content="取消" Click="OnCancelClick"/>
                <Button x:Name="ConfirmBtn" Style="{StaticResource BtnDanger}" MinWidth="92"
                        Margin="10,0,0,0" Click="OnConfirmClick">
                    <TextBlock x:Name="ConfirmText" Text="执行"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
