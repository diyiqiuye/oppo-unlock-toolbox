<Window x:Class="OppoUnlockToolbox.Ui.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OppoUnlockToolbox.Ui"
        Title="关于 OPPO 解锁工具箱"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Base}"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource R.Card}"
            BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="16">
        <StackPanel Margin="24,22,24,20">
            <TextBlock Text="OPPO 解锁工具箱" FontSize="20" FontWeight="SemiBold"/>
            

            <Separator Style="{StaticResource AppSeparator}" Margin="0,16"/>

            <TextBlock Text="项目作者" FontSize="12" Foreground="{StaticResource Ink3}"/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="64" Height="64" CornerRadius="32"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/author.jpg"
                           Stretch="UniformToFill" Width="62" Height="62"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AuthorNameText" Text="" FontSize="16" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource ChipAmber}" Margin="10,0,0,0">
                            <TextBlock x:Name="CoolapkChipText" Text="" FontSize="11.5"
                                       Foreground="{StaticResource AccentText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="工具箱开发 &amp; 机型适配" FontSize="12" Foreground="{StaticResource Ink2}"
                               Margin="0,3,0,0"/>
                    <TextBlock x:Name="BlessingText" Text="" FontSize="12" Foreground="{StaticResource Ink}"
                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                    
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="GithubBtn" Style="{StaticResource BtnDefault}" Height="32"
                        Click="OnGithubClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="link" Size="14" Margin="0,0,7,0"/>
                        <TextBlock Text="GitHub 主页" FontSize="12.5"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CoolapkBtn" Style="{StaticResource BtnDefault}" Height="32" Margin="10,0,0,0"
                        Click="OnCoolapkClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="link" Size="14" Margin="0,0,7,0"/>
                        <TextBlock Text="酷安主页" FontSize="12.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Separator Style="{StaticResource AppSeparator}" Margin="0,16"/>

            <Button x:Name="CloseBtn" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right"
                    MinWidth="96" Click="OnCloseClick">
                <StackPanel Orientation="Horizontal">
                    <ui:IconBox Key="check" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="关闭"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
