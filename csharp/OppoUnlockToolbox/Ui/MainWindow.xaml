<Window x:Class="OppoUnlockToolbox.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OppoUnlockToolbox.Ui"
        Title="OPPO 解锁工具箱 —— Find X5 Pro / Find X6 Pro"
        Width="1280" Height="880" MinWidth="1020" MinHeight="660"
        Background="{StaticResource Base}"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="210" MinHeight="120"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,14,20,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OPPO 解锁工具箱" FontSize="20" FontWeight="SemiBold"/>
                <Border Style="{StaticResource ChipNeutral}" Margin="12,0,0,2">
                    <TextBlock x:Name="VersionChip" Text="v0.2" FontSize="12"
                               Foreground="{StaticResource Ink2}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshBtn" Style="{StaticResource BtnDefault}" Click="OnRefreshClick"
                        AutomationProperties.Name="重新检测">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="refresh" Size="15" Margin="0,0,7,0"/>
                        <TextBlock Text="重新检测"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnDefault}" Margin="8,0,0,0" Click="OnBackupDirClick"
                        AutomationProperties.Name="打开备份目录">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="folder" Size="15" Margin="0,0,7,0"/>
                        <TextBlock Text="打开备份目录"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnDefault}" Margin="8,0,0,0" Click="OnResourcesClick"
                        AutomationProperties.Name="资源下载">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="download" Size="15" Margin="0,0,7,0"/>
                        <TextBlock Text="资源下载"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnDefault}" Margin="8,0,0,0" Click="OnAboutClick"
                        AutomationProperties.Name="关于">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconBox Key="info" Size="15" Margin="0,0,7,0"/>
                        <TextBlock Text="关于"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="1" Style="{StaticResource AppSeparator}" Margin="20,0,20,4"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="20,10,0,6" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                    <StackPanel x:Name="StageRailHost" Margin="0,2,2,12"/>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="设备环境" FontSize="12" Foreground="{StaticResource Ink3}"/>
                        <TextBlock x:Name="ProbeHint" Text="按 F5 重新检测（只读）" FontSize="12"
                                   Foreground="{StaticResource Ink3}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="TileTools" Grid.Row="0" Grid.Column="0" Style="{StaticResource TileCard}"/>
                        <Border x:Name="TileDevice" Grid.Row="0" Grid.Column="2" Style="{StaticResource TileCard}"/>
                        <Border x:Name="TileSystem" Grid.Row="2" Grid.Column="0" Style="{StaticResource TileCard}"/>
                        <Border x:Name="TileLock" Grid.Row="2" Grid.Column="2" Style="{StaticResource TileCard}"/>
                    </Grid>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="RightScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="20,10,20,6">
                    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource R.Card}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel Margin="20,18,20,18">

                            <StackPanel Orientation="Horizontal" >
                                <Border Style="{StaticResource ChipAmber}">
                                    <TextBlock x:Name="StageChipText" Text="阶段 1 / 7" FontSize="12"
                                               Foreground="{StaticResource AccentText}"/>
                                </Border>
                                <TextBlock x:Name="RootFlagText" Text="" FontSize="12"
                                           Foreground="{StaticResource Ink2}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="DangerChip" Style="{StaticResource ChipDanger}"
                                        Margin="8,0,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:IconBox Key="alert" Size="12" Margin="0,0,4,0"
                                                    Foreground="{StaticResource Danger}"/>
                                        <TextBlock Text="危险" FontSize="12" Foreground="{StaticResource Danger}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="StageTitleText" Text="" FontSize="{StaticResource FontH1}"
                                       FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <Border x:Name="DangerBanner" Background="{StaticResource DangerSoft}"
                                    CornerRadius="{StaticResource R.Control}" Padding="12,8"
                                    Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ui:IconBox Key="alert" Size="15" Margin="0,1,8,0"
                                                Foreground="{StaticResource Danger}"/>
                                    <TextBlock x:Name="DangerText" Text="" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource Danger}" MaxWidth="760"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="RunBtn" Style="{StaticResource BtnPrimary}" Click="OnRunClick"
                                        AutomationProperties.Name="执行本阶段">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:IconBox x:Name="RunBtnIcon" Key="play" Size="15" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="RunBtnText" Text="执行本阶段"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StopBtn" Style="{StaticResource BtnDefault}" Margin="8,0,0,0"
                                        Click="OnStopClick" IsEnabled="False"
                                        AutomationProperties.Name="停止">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:IconBox Key="stop" Size="15" Margin="0,0,7,0"/>
                                        <TextBlock Text="停止"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnDefault}" Margin="8,0,0,0" Click="OnCopyClick"
                                        AutomationProperties.Name="复制命令">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:IconBox Key="copy" Size="15" Margin="0,0,7,0"/>
                                        <TextBlock Text="复制命令"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ProgressBar" Style="{StaticResource AppProgress}"
                                             Height="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProgressText" Grid.Column="1" Text="就绪" FontSize="12"
                                           Foreground="{StaticResource Ink2}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" MaxWidth="460"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Separator Style="{StaticResource AppSeparator}" Margin="4,16"/>

                    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource R.Card}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel x:Name="ParamsHost" Margin="20,16,20,20"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows" Cursor="SizeNS"/>

        <Grid Grid.Row="4" Margin="20,2,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="实时输出" FontSize="12" Foreground="{StaticResource Ink3}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LogHint" Text="" FontSize="12" Foreground="{StaticResource Ink3}"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="AutoScrollCheck" Style="{StaticResource AppCheck}" Content="自动滚动"
                              IsChecked="True" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="ClearBtn" Style="{StaticResource BtnDefault}" Height="30" Margin="12,0,0,0"
                            Click="OnClearLogClick">
                        <TextBlock Text="清空" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource BtnDefault}" Height="30" Margin="8,0,0,0" Click="OnSaveLogClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconBox Key="save" Size="14" Margin="0,0,6,0"/>
                            <TextBlock Text="保存日志" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="{StaticResource R.Card}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="14,1,14,1">
                                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11.5" Foreground="{StaticResource Ink3}"
                                           VerticalAlignment="Top" Margin="0,1,12,0"/>
                                <TextBlock Text="{Binding MessageText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{Binding Brush}" MaxWidth="1100"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Window>
