
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:OppoUnlockToolbox.Ui">

    <Color x:Key="C.Base">#F6F1E8</Color>
    <SolidColorBrush x:Key="Base" Color="#F6F1E8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#2B251D"/>
    <SolidColorBrush x:Key="Ink2" Color="#6C6254"/>
    <SolidColorBrush x:Key="Ink3" Color="#9C9081"/>
    <SolidColorBrush x:Key="Line" Color="#E7DECC"/>
    <SolidColorBrush x:Key="Border" Color="#E3D9C6"/>
    <SolidColorBrush x:Key="Hover" Color="#F3EDDF"/>
    <SolidColorBrush x:Key="Pressed" Color="#ECE3D0"/>
    <SolidColorBrush x:Key="FieldDisabled" Color="#F1EBDE"/>

    <SolidColorBrush x:Key="Accent" Color="#B45309"/>
    <SolidColorBrush x:Key="AccentText" Color="#8A4E06"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#F9EEDC"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#E4C9A0"/>
    <SolidColorBrush x:Key="PrimaryBtn" Color="#2B251D"/>
    <SolidColorBrush x:Key="PrimaryBtnHover" Color="#443B2E"/>
    <SolidColorBrush x:Key="PrimaryBtnPressed" Color="#191510"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#FFF7E8"/>

    <SolidColorBrush x:Key="Danger" Color="#B3382C"/>
    <SolidColorBrush x:Key="DangerHover" Color="#C74B3E"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#F7E7E2"/>
    <SolidColorBrush x:Key="Ok" Color="#2E7D5B"/>
    <SolidColorBrush x:Key="OkSoft" Color="#E2F1E8"/>
    <SolidColorBrush x:Key="Warn" Color="#97690A"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#F6EED9"/>
    <SolidColorBrush x:Key="Info" Color="#2F6DA8"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#E5EFF7"/>
    <SolidColorBrush x:Key="FocusRing" Color="#2F6DA8"/>

    <SolidColorBrush x:Key="LvlCmd" Color="#2F6DA8"/>
    <SolidColorBrush x:Key="LvlOut" Color="#6C6254"/>
    <SolidColorBrush x:Key="LvlInfo" Color="#2B251D"/>
    <SolidColorBrush x:Key="LvlOk" Color="#2E7D5B"/>
    <SolidColorBrush x:Key="LvlWarn" Color="#97690A"/>
    <SolidColorBrush x:Key="LvlErr" Color="#B3382C"/>
    <SolidColorBrush x:Key="LvlNote" Color="#9C9081"/>

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSmall">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontBase">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontMedium">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontH2">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontH1">22</sys:Double>

    <CornerRadius x:Key="R.Card">16</CornerRadius>
    <CornerRadius x:Key="R.Tile">12</CornerRadius>
    <CornerRadius x:Key="R.Control">8</CornerRadius>
    <CornerRadius x:Key="R.Chip">999</CornerRadius>

    <Style x:Key="RootText" TargetType="TextBlock"/>

    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBase}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FieldDisabled}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnDefault" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource PrimaryBtn}"/>
        <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBtn}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBtnHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBtnPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource FieldDisabled}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Background" Value="{StaticResource Danger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Danger}"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnLink" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource R.Chip}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="ChipAmber" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
    </Style>
    <Style x:Key="ChipDanger" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
    </Style>
    <Style x:Key="ChipOk" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource OkSoft}"/>
    </Style>
    <Style x:Key="ChipNeutral" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Hover}"/>
    </Style>

    <Style x:Key="TileCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Tile}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="AppSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="FocusVisual" CornerRadius="13" BorderThickness="2"
                                BorderBrush="Transparent" Width="48" Height="30"/>
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12"
                                Background="{StaticResource Border}">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                    Background="{StaticResource Surface}" HorizontalAlignment="Left"
                                    Margin="3,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbShift" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusVisual" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource FieldDisabled}"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.6"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBase}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="30" Height="22" VerticalAlignment="Center">
                            <Border x:Name="FocusVisual" CornerRadius="7" BorderThickness="1.6"
                                    BorderBrush="Transparent" Width="26" Height="26"/>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Ink3}"
                                    BorderThickness="1.4"/>
                            <Path x:Name="Check" Data="M 4.5 9.5 L 8 13 L 13.5 5.5"
                                  Stroke="{StaticResource Surface}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="18" Height="18"
                                  Stretch="None" Opacity="0"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                          Margin="2,0,0,0" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusVisual" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBase}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="30" Height="22" VerticalAlignment="Center">
                            <Border x:Name="FocusVisual" CornerRadius="13" BorderThickness="1.6"
                                    BorderBrush="Transparent" Width="26" Height="26"/>
                            <Ellipse x:Name="Ring" Width="18" Height="18"
                                     Fill="{StaticResource Surface}"
                                     Stroke="{StaticResource Ink3}" StrokeThickness="1.4"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Fill="{StaticResource Accent}" Opacity="0"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                          Margin="2,0,0,0" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="1.6"/>
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusVisual" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBase}"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="{StaticResource R.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.6"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Ink3}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FieldDisabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSeparator" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Line}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="AppProgressTemplate" TargetType="ProgressBar">
        <Grid>
            <Border x:Name="PART_Track" CornerRadius="5" Background="#EFE7D6" Height="10"/>
            <Border x:Name="PART_Indicator" CornerRadius="5" Background="{StaticResource Accent}"
                    HorizontalAlignment="Left" Height="10"/>
            <Border x:Name="IndeterminateHost" CornerRadius="5" Background="#EFE7D6" Height="10"
                    ClipToBounds="True" Visibility="Collapsed">
                <Rectangle x:Name="IndBar" Width="72" Fill="{StaticResource Accent}" RadiusX="5" RadiusY="5"
                           HorizontalAlignment="Left">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="IndShift" X="-80"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="IndeterminateHost" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="IndStoryboard">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="IndShift"
                                             Storyboard.TargetProperty="X"
                                             From="-80" To="600" Duration="0:0:1.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="IndStoryboard"/>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="AppProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template" Value="{StaticResource AppProgressTemplate}"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>

    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBar" CornerRadius="4" Background="#D9CFBB" Margin="2,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBar" Property="Background" Value="#C4B79F"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBar" Property="Background" Value="#B0A288"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SlimScrollPage}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SlimScrollPage}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource SlimScrollPage}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource SlimScrollPage}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
