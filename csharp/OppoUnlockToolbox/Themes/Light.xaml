<!-- 浅色主题配色，键名对应参考项目 themes.css 的 :root 变量。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Background" Color="#F5F7F8"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#F0F2F4"/>

    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#F7F9FA"/>
    <SolidColorBrush x:Key="SurfaceActive" Color="#EEF2F3"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#17191C"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#62666D"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#969BA3"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#B7BBC1"/>
    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Border" Color="#E3E6E8"/>
    <SolidColorBrush x:Key="BorderLight" Color="#ECEEEF"/>
    <SolidColorBrush x:Key="Divider" Color="#ECEEF0"/>

    <SolidColorBrush x:Key="BrandPrimary" Color="#10B768"/>
    <SolidColorBrush x:Key="BrandHover" Color="#079E58"/>
    <SolidColorBrush x:Key="BrandActive" Color="#05844B"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#EAF8F0"/>
    <SolidColorBrush x:Key="BrandSoftHover" Color="#DDF4E7"/>
    <SolidColorBrush x:Key="BrandBorder" Color="#C3EDD9"/>

    <SolidColorBrush x:Key="Success" Color="#10B768"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="Warning" Color="#F59F00"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#FFFDF0"/>
    <SolidColorBrush x:Key="Danger" Color="#F04444"/>
    <SolidColorBrush x:Key="DangerHover" Color="#C0392B"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FFF5F5"/>
    <SolidColorBrush x:Key="Info" Color="#2F80ED"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#EEF4FE"/>

    <SolidColorBrush x:Key="FieldDisabled" Color="#F0F2F4"/>
    <SolidColorBrush x:Key="FocusRing" Color="#7FD4A8"/>

    <SolidColorBrush x:Key="ScrollThumb" Color="#29000000"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#59000000"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="WindowControlActive" Color="#1A000000"/>

    <SolidColorBrush x:Key="LvlCmd" Color="#2F80ED"/>
    <SolidColorBrush x:Key="LvlOut" Color="#62666D"/>
    <SolidColorBrush x:Key="LvlInfo" Color="#17191C"/>
    <SolidColorBrush x:Key="LvlOk" Color="#10B768"/>
    <SolidColorBrush x:Key="LvlWarn" Color="#F59F00"/>
    <SolidColorBrush x:Key="LvlErr" Color="#F04444"/>
    <SolidColorBrush x:Key="LvlNote" Color="#969BA3"/>

</ResourceDictionary>
